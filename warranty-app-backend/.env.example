# ============================================
# Warranty Manager Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warranty_manager
DB_USER=postgres
DB_PASSWORD=your_database_password

# ============================================
# JWT Authentication
# ============================================
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Google OAuth Configuration
# ============================================
# Get from Google Cloud Console: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# AWS S3 Storage Configuration
# ============================================
# For document/receipt storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=warranty-manager-documents

# ============================================
# Firebase Cloud Messaging (Push Notifications)
# ============================================
# Optional: Firebase project ID (can also be set in firebase-service-account.json)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ============================================
# Google Cloud Vision API (OCR)
# ============================================
# Optional: Path to Google Cloud Vision service account key file
# Leave empty to use Tesseract OCR (free, offline)
GOOGLE_VISION_KEY_PATH=./google-vision-key.json

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# For development: http://localhost:19000,http://192.168.1.100:19000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:19000,http://192.168.1.100:19000

# ============================================
# Database Seeding (Development Only)
# ============================================
# Set to 'true' to seed database with initial data on startup
SEED_DB=false
