# ============================================
# Warranty Manager Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warranty_manager
DB_USER=postgres
DB_PASSWORD=

# ============================================
# JWT Authentication
# ============================================
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=CM3yEubw99j13bjDQ7hz4uxSg0JC7h0O9Qx3S0O0TBJ
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=Q/:O5ku6[Iswq?0gg|Rx&4|_Guvccn*yW!m@!cQ[/=Z
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Google OAuth Configuration
# ============================================
# Get from Google Cloud Console: https://console.cloud.google.com
GOOGLE_CLIENT_ID=1011307825941-h7psi33eqq5d6k42vohpv2fveiae53fj.apps.googleusercontent.com

# ============================================
# AWS S3 Storage Configuration
# ============================================
# For document/receipt storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=warranty-manager-documents

# ============================================
# Firebase Cloud Messaging (Push Notifications)
# ============================================
# Optional: Firebase project ID (can also be set in firebase-service-account.json)
FIREBASE_PROJECT_ID=warranty-manager-477813

# ============================================
# Google Cloud Vision API (OCR)
# ============================================
# Optional: Path to Google Cloud Vision service account key file
# Leave empty to use Tesseract OCR (free, offline)
GOOGLE_VISION_KEY_PATH=

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# For development: http://localhost:19000,http://192.168.1.100:19000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:19000,http://192.168.1.100:19000

# ============================================
# Database Seeding (Development Only)
# ============================================
# Set to 'true' to seed database with initial data on startup
SEED_DB=false
