# ============================================
# Warranty Manager Mobile App - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
#
# Note: React Native doesn't support .env files natively
# You'll need to use react-native-config or update src/constants/config.js
# ============================================

# ============================================
# API Configuration
# ============================================
# Development: Use your local IP address (e.g., http://192.168.1.100:3000/api/v1)
# Production: Your production API URL (e.g., https://api.warranty-app.com/api/v1)
API_URL=http://192.168.1.100:3000/api/v1

# ============================================
# Google OAuth Configuration
# ============================================
# Get from Google Cloud Console: https://console.cloud.google.com
# You need separate client IDs for web, iOS, and Android

# Web Client ID (for web OAuth flow)
GOOGLE_WEB_CLIENT_ID=1011307825941-h7psi33eqq5d6k42vohpv2fveiae53fj.apps.googleusercontent.com

# iOS Client ID
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Android Client ID
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ============================================
# Development Notes
# ============================================
# To use these environment variables in React Native:
# 1. Install react-native-config: npm install react-native-config
# 2. Update src/constants/config.js to use Config from react-native-config
# 3. Or manually update src/constants/config.js with your values
#
# Example usage in config.js:
# import Config from 'react-native-config';
# export const API_URL = Config.API_URL || 'http://localhost:3000/api/v1';
